{
  "name": "IINA Store",
  "identifier": "com.example.iina-store",
  "version": "0.0.1",
  "description": "IINA plugin store",
  "author": {
    "name": "Caleb Ashiangmor",
    "email": "schniffenhousen@gmail.com",
