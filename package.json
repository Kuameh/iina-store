{
  "name": "iina-store",
  "version": "0.0.1",
  "description": "An IINA plugin that discovers, searches, and installs other IINA plugins from inside IINA itself.",
  "main": "src/index.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kuameh/iina-store.git"
  },
  "homepage": "https://github.com/Kuameh/iina-store#readme",
  "bugs": {
    "url": "https://github.com/Kuameh/iina-store/issues"
  },
  "scripts": {
    "serve-window": "parcel serve ui/window/index.html --dist-dir dist/ui/window",
    "serve-sidebar": "parcel serve ui/sidebar/index.html --dist-dir dist/ui/sidebar",
    "build": "rm -rf dist && parcel build .",
    "typecheck": "tsc --noEmit",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "author": {
    "name": "Caleb Ashiangmor",
    "email": "schniffenhousen@gmail.com",
    "url": "https://github.com/kuameh"
  },
  "license": "ISC",
  "devDependencies": {
    "@parcel/transformer-sass": "^2.8.3",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "iina-plugin-definition": "^0.0.7",
    "prettier": "^2.8.8",
    "process": "^0.11.10",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "parcel": "^2.8.3",
    "parcel-optimizer-webview": "git+https://github.com/iina/parcel-optimizer-webview.git",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "browserslist": "safari >= 9",
  "targets": {
    "main": false,
    "window": {
      "distDir": "./dist/ui/window",
      "source": "ui/window/index.html",
      "publicUrl": "./"
    },
    "sidebar": {
      "distDir": "./dist/ui/sidebar",
      "source": "ui/sidebar/index.html",
      "publicUrl": "./"
    },
    "global": {
      "distDir": "./dist/",
      "source": "src/global.ts",
      "isLibrary": false
    },
    "entry": {
      "distDir": "./dist/",
      "source": "src/index.ts",
      "isLibrary": false
    }
  }
}